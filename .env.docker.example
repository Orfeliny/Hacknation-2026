# Szablon dla docker-compose.yml (on-premise). Skopiuj do .env.docker.local i uzupełnij.
# .env.docker.local jest ignorowany przez Git (reguła .env*.local). Nie wpisuj tu prawdziwych sekretów.

# Nazwa instancji (dowolna, bez spacji).
INSTANCE_NAME=urzad-demo

# Sekret instancji. Wygeneruj 32 losowe bajty w hex, PowerShell:
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | % { $_.ToString('x2') }) -join ''
# Uwaga: dokumentacja Convex nie podaje formatu tej wartości; to założenie, do weryfikacji przy pierwszym uruchomieniu.
INSTANCE_SECRET=

# Adresy, pod którymi backend widzi przeglądarka w sieci urzędu. Dla jednej maszyny zostaw localhost.
# Dla innych komputerów podaj adres serwera, np. http://192.168.1.20:3210 (i 3211 dla SITE).
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
