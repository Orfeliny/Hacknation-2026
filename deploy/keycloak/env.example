# Zmienne profilu `auth` w docker-compose.yml (Keycloak, #42). Skopiuj wartości do swojego pliku
# środowiskowego Compose (ten sam, który podajesz w --env-file) i ustaw własne. Nie wpisuj tu prawdziwych
# haseł i nie dodawaj tego pliku z wartościami do Gita.
#
# Hasło administratora konsoli Keycloak (http://keycloak:8080). Wymagane.
KEYCLOAK_ADMIN_PASSWORD=<ustaw-wlasne-haslo>
#
# Hasło wszystkich użytkowników demo z deploy/keycloak/realm-demo.json. Wymagane. Tylko do lokalnego demo:
# na serwerze dostępnym spoza sieci lokalnej użyj prawdziwych kont, nie importu użytkowników demo.
KEYCLOAK_DEMO_PASSWORD=<ustaw-inne-haslo>
#
# Publiczny adres Keycloaka. Wyznacza pole `iss` w tokenach i musi być identyczny z domeną w
# convex/auth.config.ts oraz z adresem, pod którym Keycloaka widzi przeglądarka. Domyślnie
# http://keycloak:8080 (lokalnie wymaga wpisu `127.0.0.1 keycloak` w pliku hosts).
# KEYCLOAK_PUBLIC_URL=http://keycloak:8080
